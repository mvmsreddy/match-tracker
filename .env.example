# Server-only — used by api/ai-review.js (the "Review with AI" feature).
# Do NOT prefix with VITE_ (that would bundle it into the client). Set the
# real value in the Vercel project dashboard, not in this file or .env.
ANTHROPIC_API_KEY=

# Web Push (Phase 3, item 7) — the VAPID *public* key only (safe to expose
# client-side). Must match the VAPID_PUBLIC_KEY secret configured for the
# send-push Edge Function (supabase/functions/send-push). Generate a
# keypair with `npx web-push generate-vapid-keys`, or any VAPID generator.
VITE_VAPID_PUBLIC_KEY=

